# PostgreSQL
POSTGRES_USER=hospital_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=hospital_db

# App
DATABASE_URL=postgresql+psycopg://hospital_user:change-me-strong-password@db:5432/hospital_db
JWT_SECRET=change-me-to-a-random-secret-key
JWT_EXPIRE_MINUTES=60
LOG_LEVEL=INFO

# Docker image tag
IMAGE_TAG=ghcr.io/pathlavathchanti/hospital-management-platform:latest
